# SMTP (aanvragen / mail)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Intern beheer (lang sterk token)
INTERNAL_ADMIN_TOKEN=

# Cloudflare Turnstile (aanbevolen productie: beide zetten)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting over serverless — optioneel; zonder: in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optioneel: rate limits (zie lib/security/rate-limit.ts en public-api-guard)
# RATE_LIMIT_AI_CALCULATOR_MAX=8
# RATE_LIMIT_AI_CALCULATOR_WINDOW_SEC=3600
# RATE_LIMIT_PUBLIC_LEADS_MAX=5
# RATE_LIMIT_PUBLIC_LEADS_WINDOW_SEC=3600
# RATE_LIMIT_INTERNAL_LOGIN_MAX=20
# RATE_LIMIT_INTERNAL_LOGIN_WINDOW_SEC=900

# Optioneel: max body bytes
# MAX_BODY_AI_CALCULATOR_BYTES=64000
# MAX_BODY_PUBLIC_LEADS_BYTES=32000000
# MAX_BODY_SEND_LIGHTPLAN_BYTES=18000000
